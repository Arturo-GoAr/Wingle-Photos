<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinglePhotos.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinglePhotos"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WinglePhotos"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="WinglePhotos">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="1"
            PaneTitle="Wingle Photos"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="RootNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="AllPhotosItem" Content="Todo" Tag="all" Icon="Pictures" />
                <NavigationViewItem Content="Fotos" Tag="photos" Icon="Camera" />
                <NavigationViewItem Content="Videos" Tag="videos" Icon="Video" />
                <NavigationViewItem Content="Favoritos" Tag="favorites" Icon="Favorite" />
                <NavigationViewItem Content="Carpetas" Tag="folders" Icon="Folder" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Configuración" Tag="settings" Icon="Setting" />
                <NavigationViewItem Content="Ayuda / Documentación" Tag="help" Icon="Help" />
            </NavigationView.FooterMenuItems>

            <!--
                The Frame hosts pages for your application content. Add your UI to
                the individual feature pages rather than here so you can use Page
                features such as navigation events and the Loaded lifecycle.
            -->
            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
