<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinglePhotos.Features.PhotoLibrary.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinglePhotos.Features.PhotoLibrary"
    xmlns:shared="using:WinglePhotos.Shared"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <shared:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <shared:BoolToStarGlyphConverter x:Key="BoolToStarGlyphConverter" />
        <CollectionViewSource
            x:Name="GroupedPhotosSource"
            IsSourceGrouped="True"
            Source="{x:Bind ViewModel.Groups, Mode=OneWay}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
            <AppBarButton Icon="Refresh" Label="Actualizar" Command="{x:Bind ViewModel.RescanCommand}" />
            <AppBarSeparator />
            <AppBarButton Label="{x:Bind ViewModel.PhotoCount, Mode=OneWay}" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarElementContainer VerticalAlignment="Stretch">
                <ComboBox
                    Width="180"
                    VerticalAlignment="Center"
                    PlaceholderText="Filtrar por etiqueta"
                    ItemsSource="{x:Bind ViewModel.TagOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedTag, Mode=TwoWay}" />
            </AppBarElementContainer>
            <AppBarButton Icon="Clear" Label="Quitar filtro" Command="{x:Bind ViewModel.ClearTagFilterCommand}" />
        </CommandBar>

        <Grid Grid.Row="1">
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="48"
                Height="48" />

            <TextBlock
                Text="Sin fotos que mostrar. Agrega una carpeta para empezar."
                Style="{StaticResource BodyTextBlockStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <GridView
                x:Name="PhotosGridView"
                ItemsSource="{x:Bind GroupedPhotosSource.View, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="PhotosGridView_ItemClick"
                ContainerContentChanging="PhotosGridView_ContainerContentChanging"
                Padding="12">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:PhotoItem">
                        <Grid Width="150" Height="150" Margin="2">
                            <Grid.Resources>
                                <MenuFlyout x:Key="ItemMenuFlyout" Placement="Bottom">
                                    <MenuFlyoutItem Text="Favorito" Tag="{x:Bind}" Click="FavoriteMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToStarGlyphConverter}}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Agregar etiqueta" Tag="{x:Bind}" Click="AddTagMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8EC;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Ver detalles" Tag="{x:Bind}" Click="ViewDetailsMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Eliminar" Tag="{x:Bind}" Click="DeleteMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.Resources>
                            <!--
                                ContextFlyout is set here, after Grid.Resources, via property-element
                                syntax rather than as an inline attribute on the opening tag. Inline
                                attribute syntax sets ContextFlyout before this Grid's own Resources
                                dictionary is guaranteed populated, which intermittently threw
                                XamlParseException("Cannot find a Resource with the Name/Key
                                ItemMenuFlyout") once GridView started instantiating many item
                                templates back-to-back during a large scan.
                            -->
                            <Grid.ContextFlyout>
                                <StaticResource ResourceKey="ItemMenuFlyout" />
                            </Grid.ContextFlyout>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                            <FontIcon
                                Glyph="&#xE768;"
                                Foreground="White"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind IsVideo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button
                                Click="FavoriteButton_Click"
                                Tag="{x:Bind}"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="2"
                                Padding="6">
                                <FontIcon
                                    Glyph="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToStarGlyphConverter}}"
                                    Foreground="Gold"
                                    FontSize="16" />
                            </Button>
                            <Button
                                Flyout="{StaticResource ItemMenuFlyout}"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="2"
                                Padding="6">
                                <FontIcon Glyph="&#xE712;" Foreground="White" FontSize="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
                <GridView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="local:PhotoDateGroup">
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Margin="4,16,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <!--
                            Without an explicit ItemsWrapGrid panel here, grouped GridView falls
                            back to a non-virtualizing panel that realizes every item in every
                            group up front — this is what made the initial gallery load feel so
                            heavy. ItemsWrapGrid restores per-group container virtualization so
                            only on-screen (plus cache) items are realized.
                        -->
                        <GroupStyle.Panel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GroupStyle.Panel>
                    </GroupStyle>
                </GridView.GroupStyle>
            </GridView>
        </Grid>
    </Grid>
</Page>
