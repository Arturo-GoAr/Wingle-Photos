<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinglePhotos.Features.PhotoLibrary.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinglePhotos.Features.PhotoLibrary"
    xmlns:sources="using:WinglePhotos.Features.PhotoSources"
    xmlns:shared="using:WinglePhotos.Shared"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <shared:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <shared:BoolToStarGlyphConverter x:Key="BoolToStarGlyphConverter" />
        <CollectionViewSource
            x:Name="GroupedPhotosSource"
            IsSourceGrouped="True"
            Source="{x:Bind ViewModel.Groups, Mode=OneWay}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
            <AppBarButton Icon="Folder" Label="Carpetas de origen">
                <AppBarButton.Flyout>
                    <Flyout>
                        <StackPanel Spacing="8" Width="320">
                            <TextBlock Text="Carpetas de origen" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ListView
                                ItemsSource="{x:Bind ViewModel.Sources}"
                                SelectionMode="None"
                                MaxHeight="240">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="sources:PhotoSource">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{x:Bind DisplayPath}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="No disponible"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Visibility="{x:Bind IsUnavailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Click="RemoveSourceButton_Click"
                                                Tag="{x:Bind}"
                                                IsEnabled="{x:Bind CanRemove}"
                                                Content="Quitar" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="Agregar carpeta…" Command="{x:Bind ViewModel.AddSourceCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Refresh" Label="Actualizar" Command="{x:Bind ViewModel.RescanCommand}" />
            <AppBarToggleButton Icon="OutlineStar" Label="Solo favoritos" IsChecked="{x:Bind ViewModel.ShowFavoritesOnly, Mode=TwoWay}" />
            <AppBarSeparator />
            <AppBarButton Label="{x:Bind ViewModel.PhotoCount, Mode=OneWay}" IsEnabled="False" />
        </CommandBar>

        <Grid Grid.Row="1">
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="48"
                Height="48" />

            <TextBlock
                Text="Sin fotos que mostrar. Agrega una carpeta para empezar."
                Style="{StaticResource BodyTextBlockStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <GridView
                x:Name="PhotosGridView"
                ItemsSource="{x:Bind GroupedPhotosSource.View, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="PhotosGridView_ItemClick"
                ContainerContentChanging="PhotosGridView_ContainerContentChanging"
                Padding="12">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:PhotoItem">
                        <Grid Width="150" Height="150" Margin="2">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                            <Button
                                Click="FavoriteButton_Click"
                                Tag="{x:Bind}"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="2"
                                Padding="6">
                                <FontIcon
                                    Glyph="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToStarGlyphConverter}}"
                                    Foreground="Gold"
                                    FontSize="16" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
                <GridView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="local:PhotoDateGroup">
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Margin="4,16,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </GridView.GroupStyle>
            </GridView>
        </Grid>
    </Grid>
</Page>
