<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinglePhotos.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:sources="using:WinglePhotos.Features.PhotoSources"
    xmlns:shared="using:WinglePhotos.Shared"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <shared:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <shared:EnumToBoolConverter x:Key="EnumToBoolConverter" />
    </Page.Resources>

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Configuración" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="8">
                <TextBlock Text="Tema" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton
                        Content="Sistema"
                        GroupName="Theme"
                        IsChecked="{x:Bind ViewModel.CurrentTheme, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Default}"
                        Command="{x:Bind ViewModel.SetThemeCommand}"
                        CommandParameter="Default" />
                    <RadioButton
                        Content="Claro"
                        GroupName="Theme"
                        IsChecked="{x:Bind ViewModel.CurrentTheme, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Light}"
                        Command="{x:Bind ViewModel.SetThemeCommand}"
                        CommandParameter="Light" />
                    <RadioButton
                        Content="Oscuro"
                        GroupName="Theme"
                        IsChecked="{x:Bind ViewModel.CurrentTheme, Mode=OneWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Dark}"
                        Command="{x:Bind ViewModel.SetThemeCommand}"
                        CommandParameter="Dark" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Carpetas de origen" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Content="Agregar carpeta…" Command="{x:Bind ViewModel.Library.AddSourceCommand}" />
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Library.Sources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sources:PhotoSource">
                            <Grid Padding="8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind DisplayPath}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="No disponible"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Visibility="{x:Bind IsUnavailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Click="RemoveSourceButton_Click"
                                    Tag="{x:Bind}"
                                    IsEnabled="{x:Bind CanRemove}"
                                    Content="Quitar" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
