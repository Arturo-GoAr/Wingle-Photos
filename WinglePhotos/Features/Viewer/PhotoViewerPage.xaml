<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinglePhotos.Features.Viewer.PhotoViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Invoked="PreviousAccelerator_Invoked" />
        <KeyboardAccelerator Key="Right" Invoked="NextAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="BackAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <ScrollViewer
            x:Name="ImageScrollViewer"
            ZoomMode="Enabled"
            MinZoomFactor="1"
            MaxZoomFactor="5"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Auto"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            SizeChanged="ImageScrollViewer_SizeChanged">
            <Image x:Name="PreviewImage" Stretch="Uniform" DoubleTapped="PreviewImage_DoubleTapped" />
        </ScrollViewer>

        <MediaPlayerElement
            x:Name="VideoPlayer"
            AreTransportControlsEnabled="True"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <MediaPlayerElement.TransportControls>
                <!--
                    IsCompact keeps the seek bar and the play/pause button on a single row
                    (play button lands at the same height as the time labels) instead of the
                    default multi-row layout, which left a tall, mostly-empty control bar that
                    the custom PositionText overlay collided with.
                -->
                <MediaTransportControls IsCompact="True" />
            </MediaPlayerElement.TransportControls>
        </MediaPlayerElement>

        <ProgressRing x:Name="LoadingRing" HorizontalAlignment="Center" VerticalAlignment="Center" Width="48" Height="48" />

        <Button
            Click="Back_Click"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="12">
            <FontIcon Glyph="&#xE72B;" />
        </Button>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Spacing="8">
            <Button x:Name="FavoriteButton" Click="Favorite_Click">
                <FontIcon x:Name="FavoriteIcon" />
            </Button>
            <Button>
                <FontIcon Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Agregar etiqueta" Click="AddTag_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8EC;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Ver detalles" Click="ViewDetails_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Ver en el explorador de archivos" Click="ShowInExplorer_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8DA;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Eliminar" Click="Delete_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <Button
            Click="Previous_Click"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="12">
            <FontIcon Glyph="&#xE76B;" />
        </Button>

        <Button
            Click="Next_Click"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="12">
            <FontIcon Glyph="&#xE76C;" />
        </Button>

        <TextBlock
            x:Name="PositionText"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,12,0,0"
            Foreground="White"
            Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
</Page>
