<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinglePhotos.Features.Viewer.PhotoViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Invoked="PreviousAccelerator_Invoked" />
        <KeyboardAccelerator Key="Right" Invoked="NextAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="BackAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <ScrollViewer
            x:Name="ImageScrollViewer"
            ZoomMode="Enabled"
            MinZoomFactor="1"
            MaxZoomFactor="5"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Auto"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
            <Image x:Name="PreviewImage" Stretch="Uniform" DoubleTapped="PreviewImage_DoubleTapped" />
        </ScrollViewer>

        <ProgressRing x:Name="LoadingRing" HorizontalAlignment="Center" VerticalAlignment="Center" Width="48" Height="48" />

        <Button
            Click="Back_Click"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="12">
            <FontIcon Glyph="&#xE72B;" />
        </Button>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Spacing="8">
            <Button x:Name="FavoriteButton" Click="Favorite_Click">
                <FontIcon x:Name="FavoriteIcon" />
            </Button>
            <Button Click="Delete_Click">
                <FontIcon Glyph="&#xE74D;" />
            </Button>
        </StackPanel>

        <Button
            Click="Previous_Click"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="12">
            <FontIcon Glyph="&#xE76B;" />
        </Button>

        <Button
            Click="Next_Click"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="12">
            <FontIcon Glyph="&#xE76C;" />
        </Button>

        <TextBlock
            x:Name="PositionText"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            Foreground="White"
            Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>
</Page>
